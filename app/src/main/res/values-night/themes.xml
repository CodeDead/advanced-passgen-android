<resources>
    <!-- Base application theme. -->
    <style name="Theme.AdvancedPassGen" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_blue_200</item>
        <item name="colorPrimaryVariant">@color/brand_blue_700</item>
        <item name="colorOnPrimary">@color/brand_navy_950</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/brand_blue_200</item>
        <item name="colorSecondaryVariant">@color/brand_blue_500</item>
        <item name="colorOnSecondary">@color/brand_navy_950</item>
        <!-- Background color. -->
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorBackground">@color/window_background</item>
        <!-- App bar and status bar colors. -->
        <item name="actionBarStyle">@style/Widget.AdvancedPassGen.ActionBar</item>
        <item name="android:statusBarColor">@color/app_bar_background</item>
        <!-- Customize your theme here. -->
        <item name="separatorColor">@color/password_row_stroke</item>
        <item name="selectedMenuItemColor">@color/brand_blue_200</item>
    </style>

    <style name="Theme.AdvancedPassGen.PopupOverlay" parent="ThemeOverlay.AppCompat.Dark" />
</resources>
