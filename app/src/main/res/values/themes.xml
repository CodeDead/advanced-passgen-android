<resources>
    <!-- Base application theme. -->
    <style name="Theme.AdvancedPassGen" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_blue_700</item>
        <item name="colorPrimaryVariant">@color/brand_blue_900</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/brand_blue_500</item>
        <item name="colorSecondaryVariant">@color/brand_blue_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Background color. -->
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorBackground">@color/window_background</item>
        <!-- App bar and status bar colors. -->
        <item name="actionBarStyle">@style/Widget.AdvancedPassGen.ActionBar</item>
        <item name="android:statusBarColor">@color/app_bar_background</item>
        <!-- Customize your theme here. -->
        <item name="separatorColor">@color/password_row_stroke</item>
        <item name="selectedMenuItemColor">@color/brand_blue_700</item>
    </style>

    <style name="Widget.AdvancedPassGen.ActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="background">@color/app_bar_background</item>
    </style>

    <style name="Theme.AdvancedPassGen.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.AdvancedPassGen.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.AdvancedPassGen.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
